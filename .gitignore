# 의존성 / 빌드 산출물
node_modules/
www/

# Capacitor iOS 네이티브 프로젝트는 리포에 포함(아이콘·Info.plist 등 출시 설정 보존).
# 생성물/사용자별 파일만 제외 — `npm run sync`가 다시 만들어 준다.
ios/App/App/public/
ios/App/assets/
ios/App/cordova.js
ios/App/cordova_plugins.js
ios/capacitor-cordova-ios-plugins/
ios/**/xcuserdata/
ios/App/build/
ios/DerivedData/

# Android 서명 키/비밀(절대 커밋 금지)
android/key.properties
*.jks
*.keystore

# 잡파일
.DS_Store
*.log

# 벤더링한 Capacitor 플러그인의 의존성(빌드에 불필요, npm 이 다시 만든다)
vendor/*/node_modules/

# 벤더링한 플러그인의 안드로이드 빌드 산출물
vendor/*/android/build/
